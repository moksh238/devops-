
pipeline {
    agent any

    environment {
        APP_DIR = 'python-flask-app'
        DEPLOY_DIR = 'python-app-deploy'
    }

    stages {
        stage('Build') {
            steps {
                echo 'Installing dependencies...'
                sh '''
                    cd "$APP_DIR"
                    python3 --version
                    python3 -m venv .venv
                    .venv/bin/python -m pip install --upgrade pip
                    .venv/bin/pip install -r requirements.txt
                '''
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                sh '''
                    cd "$APP_DIR"
                    .venv/bin/python -m unittest discover -s . -p "test_*.py" -v
                '''
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                sh '''
                    mkdir -p "$WORKSPACE/$DEPLOY_DIR"
                    cp "$APP_DIR/app.py" "$WORKSPACE/$DEPLOY_DIR/"
                    cp "$APP_DIR/requirements.txt" "$WORKSPACE/$DEPLOY_DIR/"
                '''
            }
        }

        stage('Run Application') {
            steps {
                echo 'Starting and checking Flask application...'
                sh '''
                    set -eu

                    "$WORKSPACE/$APP_DIR/.venv/bin/python" \
                        "$WORKSPACE/$DEPLOY_DIR/app.py" \
                        > "$WORKSPACE/$DEPLOY_DIR/app.log" 2>&1 &

                    APP_PID=$!
                    trap 'kill "$APP_PID" 2>/dev/null || true; wait "$APP_PID" 2>/dev/null || true' EXIT

                    READY=0

                    for i in $(seq 1 20); do
                        if curl -fsS http://127.0.0.1:5000/ \
                            -o "$WORKSPACE/$DEPLOY_DIR/response.txt"; then
                            READY=1
                            break
                        fi

                        if ! kill -0 "$APP_PID" 2>/dev/null; then
                            cat "$WORKSPACE/$DEPLOY_DIR/app.log"
                            exit 1
                        fi

                        sleep 1
                    done

                    if [ "$READY" -ne 1 ]; then
                        cat "$WORKSPACE/$DEPLOY_DIR/app.log"
                        echo "Application failed to start."
                        exit 1
                    fi

                    cat "$WORKSPACE/$DEPLOY_DIR/response.txt"
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Verifying application response...'
                sh '''
                    "$WORKSPACE/$APP_DIR/.venv/bin/python" -c "
from pathlib import Path
response = Path('$DEPLOY_DIR/response.txt').read_text()
assert response == 'Hello, Jenkins Multi-Stage Pipeline!'
print('Application response verified successfully!')
"
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the console output.'
        }
        always {
            echo 'Pipeline execution finished.'
        }
    }
}
